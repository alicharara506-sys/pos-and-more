# ==============================================================================
# SalesMaster Pro — environment variables
# Copy to .env and fill in real values. Never commit real secrets.
# ==============================================================================

# --- Core ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# Exposed to the browser bundle by Next.js (apps/web) — must be prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- Database ---
DATABASE_URL=postgresql://salesmaster:salesmaster@localhost:5432/salesmaster
# Direct (non-pooled) connection, used by Prisma migrate
DIRECT_URL=postgresql://salesmaster:salesmaster@localhost:5432/salesmaster

# --- Redis / jobs ---
REDIS_URL=redis://localhost:6379

# --- Auth / sessions ---
# 32+ byte random string used to sign session/JWT tokens.
AUTH_JWT_SECRET=
# 32+ byte random string used to encrypt refresh tokens & provider secrets at rest.
AUTH_ENCRYPTION_KEY=
AUTH_SESSION_TTL_MINUTES=43200
AUTH_MAGIC_LINK_TTL_MINUTES=15

# --- Google OAuth (Continue with Google) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/auth/google/callback

# --- Apple OAuth (Sign in with Apple) ---
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
# PEM-encoded private key for the Apple Sign in key, base64-encoded for env storage.
APPLE_OAUTH_PRIVATE_KEY_BASE64=
APPLE_OAUTH_REDIRECT_URI=http://localhost:4000/auth/apple/callback

# --- Stripe Billing ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs backing the pricing catalog (see docs/billing.md)
STRIPE_PRICE_BASE_MONTHLY=
STRIPE_PRICE_BRANCH_MONTHLY=
STRIPE_PRICE_USER_MONTHLY=

# --- Transactional email provider ---
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=no-reply@salesmasterpro.example
SENDGRID_API_KEY=
RESEND_API_KEY=

# --- SMS / WhatsApp (optional) ---
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Object storage (S3-compatible) ---
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# --- AI Assistant provider ---
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_LOCAL_MODEL_ENDPOINT=

# --- Observability ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info

# --- Platform admin ---
PLATFORM_ADMIN_JWT_SECRET=
